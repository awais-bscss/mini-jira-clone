{
  "services": {
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/assets/:path*",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/vite.svg",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/favicon.svg",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/icons.svg",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/:path*",
      "destination": {
        "service": "frontend",
        "path": "/index.html"
      }
    }
  ]
}
